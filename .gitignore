# Python caches & tests
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Virtual environments & secrets
.venv/
venv/
.env
.env.*

# Runtime KDB-X binary caches & metadata
kdb_store/*.kdb
kdb_store/meta/
!kdb_store/.gitkeep

# Generated user research outputs & local attachments
dashboards/*.html
!dashboards/.gitkeep
memos/*.md
!memos/.gitkeep
*.pdf
*.xlsx

# OS & editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
